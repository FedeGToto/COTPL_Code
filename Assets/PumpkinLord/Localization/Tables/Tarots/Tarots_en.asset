  m_TableData:
  - m_Id: 35326586880
    m_Localized: 'Gain 1 <color=yellow>revive</color>. The next time Dullahan dies,
      consume 1 <color=yellow>revive</color> and revive them with 50% Max HP.


      There
      is a {value}% your attack misses.'
    m_Metadata:
      m_Items:
      - rid: 7264864321863942226
  - m_Id: 10093654016
    m_Localized: 0. The Fool
    m_Metadata:
      m_Items: []
  - m_Id: 555101515776
    m_Localized: I. The Magician
    m_Metadata:
      m_Items: []
  - m_Id: 593357762560
    m_Localized: 'Your spells are <color=green>{meritValue}%</color> more effective.


      Your
      spells costs <color=red>{demeritValue}%</color> more MP.'
    m_Metadata:
      m_Items:
      - rid: 7264864321863942226
  - m_Id: 781317107712
    m_Localized: II. The High Priestess
    m_Metadata:
      m_Items: []
  - m_Id: 848828624896
    m_Localized: 'You have a {meritValue}% to dodge an enemy attack.


      Each
      turn you gain {demeritValue} <color=yellow>Insanity</color> stacks.'
    m_Metadata:
      m_Items:
      - rid: 7264864321863942226
  - m_Id: 1067788070912
    m_Localized: XII. The Hanged Man
    m_Metadata:
      m_Items: []
  - m_Id: 1113094942720
    m_Localized: 'Gain 1 stack of <color=yellow>Hanged</color>. The next time you
      use <color=red>Head Throw</color>, consume a stack of <color=yellow>Hanged</color>.
      Current stacks: {value}


      You''re unable to use <color=red>Head Throw</color>
      without <color=yellow>Hanged</color> stacks.'
    m_Metadata:
      m_Items:
      - rid: 7264864321863942226
  - m_Id: 1459917746176
    m_Localized: XXI. The World
    m_Metadata:
      m_Items: []
  - m_Id: 1492163555328
    m_Localized: 'When you have at least 15 Souls, your ATTACK deals <color=green>{meritValue}%</color>
      more damage.


      Until you have at least 10 Souls, your ATTACK deals <color=red>{demeritValue}%</color>
      less damage.'
    m_Metadata:
      m_Items:
      - rid: 7264864321863942226
